  <STRoot>
    <code>// = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =
// PRG_STF_Axis1
// 单轴 PP 位置控制
// = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = =

// 读取启动上升沿
StartMoveEdge := StartMove AND NOT StartMoveOld;
StartMoveOld := StartMove;

// 默认清除完成标志
MoveDone := FALSE;

TON1(IN := T_NewSetpoint,PET := pet,Q =&gt; Timeout,ET =&gt; et); 
// MC_Power(Axis_num := ,Enable := ,Mode := ,Axis_numOut =&gt; ,Valid =&gt; ,Error =&gt; ,ErrorID =&gt; ,Now_mode =&gt; ) 

// 状态机
CASE Step OF

    // 0 : 初始化 / 等待
    0 :
        Step := 20;

    // 20 : Shutdown
    20 :
        STF_ControlWord := 16#0006;

        IF (STF_StatusWord AND 16#006F) = 16#0021 THEN
            Step := 30;
        END_IF;


    // 30: Switch On
    30:
        STF_ControlWord := 16#0007;

        IF (STF_StatusWord AND 16#006F) = 16#0023 THEN
            Step := 40;
        END_IF;


    // 40: Enable Operation
    40:
        STF_ControlWord := 16#000F;

        IF (STF_StatusWord AND 16#006F) = 16#0027 THEN
            // 运行模式：Profile Position
            STF_Mode := 1;
            Step := 50;
        END_IF;


    // 50: 等待运动命令
    50:
        // STF_ControlWord := 16#000F;

        IF StartMoveEdge THEN

            // 设置目标运动参数
            STF_TargetPos := TargetPos;
            STF_ProfileVel := ProfileVel;
            STF_ProfileAcc := ProfileAcc;
            STF_ProfileDec := ProfileDec;

            Step := 60;
        END_IF;


    // 60 : 触发新的位置设定点
    60 :
        STF_ControlWord := 16#001F;
        
        T_NewSetpoint := TRUE;
        
        WHILE(NOT Timeout) DO
        ;
        END_WHILE;
        
        // 等待驱动器确认新设定点
        IF (STF_StatusWord AND 16#1000) &lt;&gt; 0 THEN
            Step := 70;
        END_IF;


    // 70: 撤销 New Set-point
    70:
        STF_ControlWord := 16#000F;

        IF (STF_StatusWord AND 16#1000) = 0 THEN
            Step := 80;
        END_IF;


    // 80: 等待目标位置到达
    80:
        // STF_ControlWord := 16#000F;

        IF (STF_StatusWord AND 16#0400) &lt;&gt; 0 THEN
            MoveDone := TRUE;
            Step := 50;
        END_IF;


    // 90: 停止 / 异常
    90:
        STF_ControlWord := 16#0000;

END_CASE;

END_PROGRAM</code>
